common --enable_bzlmod

# MODULE.bazel declares the crate_universe extension with isolate = True (so a
# consumer whose graph already holds a non-isolated `crates` — botnoc, per the
# comment there — can coexist). Isolated extension usages are still behind an
# experimental flag, so it must be enabled here or EVERY bazel command in this
# repo dies at MODULE parse: "parameter 'isolate' is experimental". It was
# missing, which is why nothing here has been buildable; meridian-chat, whose
# npm extension isolates for the same reason, already carries this line and the
# same explanation. Consumers that pull this module from source need it too —
# meridian-web and meridian-tui both hit it through this MODULE.bazel.
common --experimental_isolated_extension_usages

# Use the toolchain-resolved (prebuilt) protoc rather than compiling it from
# source — the CLT-only dev host can't build protoc, and CI shouldn't have to.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# meridian_schemas resolves from the tbzl registry; rules_rust,
# protobuf, googleapis, etc. from BCR.
common --registry=https://registry.tbzl.dev/
common --registry=https://bcr.bazel.build/

build --announce_rc
build --keep_going
test --test_output=errors
